@if (Cube == null)
{
    <p>wating</p>
}
else
{
    <div class="Scramble">
        <div class="CubeSideEmpty"></div>
        <div id="White" class="CubeSide">
            @for (int x = 0; x < Cube.Size; x++)
            {
                @for (int y = 0; y < Cube.Size; y++)
                {
                    <div class="CubePiece @Cube.Pieces[x][y][0].Top"></div>
                }
            }
        </div>
        <div class="CubeSideEmpty"></div>
        <div class="CubeSideEmpty"></div>
        <div id="Orange" class="CubeSide">
            @for (int z = 0; z < Cube.Size; z++)
            {
                @for (int y = 0; y < Cube.Size; y++)
                {
                    <div class="CubePiece @Cube.Pieces[0][y][z].Left"></div>
                }
            }
        </div>
        <div id="Green" class="CubeSide">
            @for (int z = 0; z < Cube.Size; z++)
            {
                @for (int x = 0; x < Cube.Size; x++)
                {
                    <div class="CubePiece @Cube.Pieces[x][Cube.Size - 1][z].Front"></div>
                }
            }
        </div>
        <div id="Red" class="CubeSide">
            @for (int z = 0; z < Cube.Size; z++)
            {
                @for (int y = 0; y < Cube.Size; y++)
                {
                    <div class="CubePiece @Cube.Pieces[Cube.Size - 1][y][z].Right"></div>
                }
            }
        </div>
        <div id="Blue" class="CubeSide">
            @for (int z = 0; z < Cube.Size; z++)
            {
                @for (int x = 0; x < Cube.Size; x++)
                {
                    <div class="CubePiece @Cube.Pieces[x][0][z].Back"></div>
                }
            }
        </div>
        <div class="CubeSideEmpty"></div>
        <div id="Yellow" class="CubeSide">
            @for (int x = 0; x < Cube.Size; x++)
            {
                @for (int y = 0; y < Cube.Size; y++)
                {
                    <div class="CubePiece @Cube.Pieces[x][y][Cube.Size - 1].Bottom"></div>
                }
            }
        </div>
        <div class="CubeSideEmpty"></div>
        <div class="CubeSideEmpty"></div>
    </div>
}
<style>
    .Scramble {
        display: flex;
        flex-wrap: wrap;
        width: @(Width)px;
        height: @(Height)px;
        gap: 10px;
        zoom: 0.75;
    }

    .CubeSide {
        width: @(SideSize)px;
        height: @(SideSize)px;
        background-color: gray;
        display: flex;
        flex-wrap: wrap;
    }

    .CubePiece {
        width: @(PieceSize)px;
        height: @(PieceSize)px;
        margin: 0px;
        padding: 0px;
        outline: 4px solid black;
    }

    .CubeSideEmpty {
        width: @(SideSize)px;
        height: @(SideSize)px;
        background-color: transparent;
    }

    .White {
        background-color: white;
    }

    .Yellow {
        background-color: yellow;
    }

    .Red {
        background-color: red;
    }

    .Orange {
        background-color: orange;
    }

    .Blue {
        background-color: blue;
    }

    .Green {
        background-color: rgb(10, 220, 10);
    }
</style>

@code {
    [Parameter]
    public CubeModel Cube { get; set; } = null!;

    private int SideSize = 300;

    private int Height => (SideSize + 10) * 3;
    private int Width => (SideSize + 10) * 4;

    private double PieceSize = 0;

    protected override void OnParametersSet()
    {
        if (Cube == null)
        {
            return;
        }

        PieceSize = (double)SideSize / Cube.Size;
    }

}